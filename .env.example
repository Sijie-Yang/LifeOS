# Local single-user installation. Relative SQLite paths resolve from prisma/.
DATABASE_URL="file:./dev.db?connection_limit=1"
# Base URL used in reminder emails, push notifications and helper scripts.
LIFEOS_URL="http://127.0.0.1:3000"
# Port for scripts/run-lifeos-dev.sh and the optional macOS LaunchAgent.
# LIFEOS_PORT="3000"

# Optional local integrations. Agent scanning is opt-in for new installations.
LIFEOS_AGENT_ACTIVITY="0"
# LIFEOS_CODEX_HOME="/absolute/path/to/.codex"
# LIFEOS_CURSOR_HOME="/absolute/path/to/.cursor"
# LIFEOS_CURSOR_STATE_DB="/absolute/path/to/state.vscdb"
# LIFEOS_CLAUDE_HOME="/absolute/path/to/.claude"
# READING_LIBRARY_ROOT="/absolute/path/to/library"
# LIFE_RECORDS_ROOT="/absolute/path/to/photos"
# OBSIDIAN_VAULT="/absolute/path/to/vault"

# Optional focused-habit allowlist. Blank means all active habits.
# LIFEOS_POMODORO_HABIT_IDS="id-one,id-two"

# Optional bot / report integrations (see docs/bot-integration.md).
# LIFEOS_EXPECTED_BOTS="research,learning,writer@135"
# LIFEOS_BOT_REPORTS_DIR="data/bot-reports"
# LIFEOS_JOB_TRACKER_CSV="data/job-tracker.csv"
# LIFEOS_BRANDING_PROJECT="Personal Branding"

# Email is optional. Keep dry-run enabled until intentionally configured.
EMAIL_DRY_RUN="1"
# EMAIL_REMINDERS_ENABLED="1"
# REMINDER_EMAIL="you@example.com"
# RESEND_API_KEY=""
# RESEND_FROM="LifeOS <you@example.com>"
# REMINDER_SECRET=""

# Optional phone / watch push via ntfy. Pick a long, unguessable topic.
# NTFY_TOPIC=""
# NTFY_SERVER="https://ntfy.sh"
